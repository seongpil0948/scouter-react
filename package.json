{
  "name": "next-app-template",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "local": "pnpm kill && next dev --turbo",
    "local2": "next dev --turbo",
    "dev": "pnpm kill && next dev --turbo",
    "build": "next build",
    "build:dev": "PORT=3000 NODE_ENV=development next build",
    "start": "next start",
    "start:dev": "PORT=3000 NODE_ENV=development next start",
    "lint": "next lint --fix",
    "prettier:fix": "prettier --write .",
    "test:ts": "tsc --noEmit",
    "test": "pnpm exec playwright test",
    "test:e2e:debug": "pnpm exec playwright test --debug",
    "test:e2e:report": "pnpm exec playwright show-report",
    "test:e2e:ui": "pnpm exec playwright test --ui",
    "test:e2e:gen": "pnpm exec playwright codegen",
    "kill": "sh -c 'if [ $(netstat -an -p tcp | grep 3000 | wc -l) -gt 0 ]; then kill-port --port 3000; fi'"
  },
